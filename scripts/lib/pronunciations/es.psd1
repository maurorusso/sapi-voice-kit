# IPA pronunciations for technical terms, so a Spanish voice says them the
# English way instead of applying Spanish letter-to-sound rules.
#
# Used only when the voice speaking is Spanish (es-ES, es-MX, ...). Another
# language gets its own file here, named by its two-letter code (en.psd1,
# pt.psd1, ...), with its own list of words and IPA; a language with no file
# gets no hints. Loaded by Get-PronunciationDictionary in lib/pronunciation.ps1.
#
# Rules for entries:
#  - Keys are single lowercase words (the tokenizer splits on word characters).
#  - Values are IPA characters with no spaces, and no apostrophe or ampersand
#    (they go inside an XML attribute for the OneCore engine).
#  - A one-syllable word still needs the stress mark, or the voice clips it.
#  - Add an entry only after listening to it with /sapi-voice-kit:test.
#  - Keep this file saved as UTF-8 with BOM.
@{
    'agent'        = 'ˈeɪdʒənt'
    'app'          = 'ˈæp'
    'argument'     = 'ˈɑrgjəmənt'
    'array'        = 'əˈreɪ'
    'async'        = 'ˈeɪsɪŋk'
    'await'        = 'əˈweɪt'
    'backend'      = 'ˈbækɛnd'
    'boolean'      = 'ˈbulɪən'
    'branch'       = 'ˈbræntʃ'
    'bug'          = 'ˈbʌɡ'
    'build'        = 'ˈbɪld'
    'cache'        = 'ˈkæʃ'
    'callback'     = 'ˈkɔlbæk'
    # Written with the vowel twice: this voice gives a repeated vowel real duration, while the IPA length mark (and tS+e variants) came out as a barely audible vowel.
    'che'          = 'ˈtʃee'
    'class'        = 'ˈklæs'
    'claude'       = 'ˈklɔd'
    'client'       = 'ˈklaɪənt'
    'clone'        = 'ˈkloʊn'
    'code'         = 'ˈkoʊd'
    'commit'       = 'kəˈmɪt'
    'compile'      = 'kəmˈpaɪl'
    'config'       = 'kənˈfɪɡ'
    'console'      = 'ˈkɑnsoʊl'
    'container'    = 'kənˈteɪnər'
    'cookie'       = 'ˈkʊki'
    'database'     = 'ˈdeɪtəbeɪs'
    'debug'        = 'diˈbʌɡ'
    'delete'       = 'dɪˈlit'
    'deploy'       = 'dɪˈplɔɪ'
    'docker'       = 'ˈdɑkər'
    'endpoint'     = 'ˈɛndpɔɪnt'
    'error'        = 'ˈɛrər'
    'export'       = 'ˈɛkspɔrt'
    'file'         = 'ˈfaɪl'
    'folder'       = 'ˈfoʊldər'
    'framework'    = 'ˈfreɪmwɜrk'
    'frontend'     = 'ˈfrʌntɛnd'
    'function'     = 'ˈfʌŋkʃən'
    'git'          = 'ˈɡɪt'
    'github'       = 'ˈɡɪthʌb'
    'header'       = 'ˈhɛdər'
    'hook'         = 'ˈhʊk'
    'import'       = 'ˈɪmpɔrt'
    'index'        = 'ˈɪndɛks'
    'input'        = 'ˈɪnpʊt'
    'install'      = 'ɪnˈstɔl'
    'interface'    = 'ˈɪntərfeɪs'
    'javascript'   = 'ˈdʒævəskrɪpt'
    'json'         = 'ˈdʒeɪsɑn'
    'library'      = 'ˈlaɪbrɛri'
    'localhost'    = 'ˈlokəlhost'
    'log'          = 'ˈlɔɡ'
    'loop'         = 'ˈlup'
    'markdown'     = 'ˈmɑrkdaʊn'
    'mcp'          = 'ɛmsiˈpi'
    'merge'        = 'ˈmɜrdʒ'
    'method'       = 'ˈmɛθəd'
    'model'        = 'ˈmodel'
    'module'       = 'ˈmɑdʒul'
    # A Spanish word, not a loanword: aguda ending in -l, so no written accent and the stress on the last syllable (na-tu-RAL). Listed because this voice stresses the first syllable, English-style.
    'natural'      = 'natuˈɾal'
    'node'         = 'ˈnoʊd'
    'npm'          = 'ɛnpiˈɛm'
    'null'         = 'ˈnʌl'
    'object'       = 'ˈɑbdʒɛkt'
    'output'       = 'ˈaʊtpʊt'
    'package'      = 'ˈpækɪdʒ'
    'parameter'    = 'pəˈræmɪtər'
    'plugin'       = 'ˈplʌɡɪn'
    'promise'      = 'ˈprɑmɪs'
    # Castellanized on purpose: a plain Spanish vowel sounded better than the English diphthong. Same for 'model' and 'localhost'. Judge each entry by ear.
    'prompt'       = 'ˈprompt'
    'pull'         = 'ˈpʊl'
    # The voice has no /sh/ phoneme (reads as 's'); this is still better than no hint.
    'push'         = 'ˈpʊʃ'
    'python'       = 'ˈpaɪθɑn'
    'query'        = 'ˈkwɪri'
    'queue'        = 'ˈkju'
    'readme'       = 'ˈridmi'
    'regex'        = 'ˈridʒɛks'
    'repo'         = 'ˈripoʊ'
    'repository'   = 'rɪˈpɑzɪtɔri'
    'request'      = 'rɪˈkwɛst'
    'response'     = 'rɪˈspɑns'
    'return'       = 'rɪˈtɜrn'
    'runtime'      = 'ˈrʌntaɪm'
    'sapi'         = 'ˈseɪpi'
    'schema'       = 'ˈskimə'
    'script'       = 'ˈskrɪpt'
    'server'       = 'ˈsɜrvər'
    'session'      = 'ˈsɛʃən'
    'skill'        = 'ˈskɪl'
    'stack'        = 'ˈstæk'
    'string'       = 'ˈstrɪŋ'
    'syntax'       = 'ˈsɪntæks'
    'terminal'     = 'ˈtɜrmɪnəl'
    'test'         = 'ˈtɛst'
    'thread'       = 'ˈθrɛd'
    'token'        = 'ˈtoʊkən'
    'typescript'   = 'ˈtaɪpskrɪpt'
    'update'       = 'ʌpˈdeɪt'
    'value'        = 'ˈvælju'
    'variable'     = 'ˈvɛriəbəl'
    # Spanish letter names ('be ese'), not English ones - the voice read the V the English way by default.
    'vs'           = 'beˈese'
    'warning'      = 'ˈwɔrnɪŋ'
    'workflow'     = 'ˈwɝrkfloʊ'
}
